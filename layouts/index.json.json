{{- /* every page that lives in a section (posts, collectables); skips search, subscribe */ -}}
{{- $pages := where site.RegularPages "Section" "ne" "" -}}
{{- $data := slice -}}
{{- range $pages -}}
{{- $data = $data | append (dict
  "title" .Title
  "permalink" .Permalink
  "date" (.Date.Format "2006-01-02")
  "summary" (.Summary | plainify | htmlUnescape)
  "content" (.Plain | htmlUnescape)
) -}}
{{- end -}}
{{- $data | jsonify -}}
